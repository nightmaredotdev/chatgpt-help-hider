{
  "manifest_version": 3,
  "name": "ChatGPT Help Hider",
  "version": "0.1.0",
  "description": "Hides the \"Help is available\" notice in ChatGPT. No data collection, no network requests.",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
