{
  "manifest_version": 3,
  "name": "ChatGPT Help Hider",
  "version": "1.0.3",
  "description": "Hides the \"Help is available\" notice in ChatGPT. No data collection, no network requests.",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{5a921c4b-e146-45b7-b5f2-2632c0b29fc1}",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
